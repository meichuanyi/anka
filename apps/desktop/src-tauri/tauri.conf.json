{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anka",
  "version": "0.1.11",
  "identifier": "app.anka.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Anka",
        "width": 960,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFNkNGNzg4NDRBQzk2N0YKUldSL2xxeEVpUGRzbnBuR3ltUGtYMC90RnNNZ01lOVJXK0xwS1NUYzd5K2VWZFBLWGI1N2lqTlgK",
      "endpoints": [
        "https://github.com/meichuanyi/anka/releases/latest/download/latest.json"
      ]
    }
  }
}